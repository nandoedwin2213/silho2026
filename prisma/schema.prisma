generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadSource {
  WEB
  WHATSAPP
  INSTAGRAM
  FACEBOOK
  TIKTOK
  GOOGLE
  REFERRAL
}

enum LeadStatus {
  NEW
  CONTACTED
  APPOINTMENT
  CONVERTED
  LOST
}

enum AppointmentStatus {
  PENDING
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  PAYPHONE
  TRANSFER
  CASH
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  ERROR
}

enum SubscriptionStatus {
  ACTIVE
  PENDING
  PAST_DUE
  CANCELLED
  PAUSED
}

enum Role {
  ADMIN
}

enum PointsReason {
  WEB_BOOKING_PAID
  PROTOCOL_COMPLETED
  PUNCTUAL_ATTENDANCE
  REFERRAL
  FOLLOW_UP
  ANNIVERSARY
  REDEMPTION
  ADJUSTMENT
  EXPIRED
}

enum RewardTier {
  ESSENTIAL
  GOLD
  BLACK
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int
  active      Boolean   @default(true)
  image       String?
  services    Service[]

  @@map("categories")
}

model Service {
  id                        String           @id @default(cuid())
  name                      String
  slug                      String           @unique
  categoryId                String           @map("category_id")
  category                  Category         @relation(fields: [categoryId], references: [id])
  description               String
  shortDescription          String           @map("short_description")
  basePrice                 Decimal          @db.Decimal(10, 2) @map("base_price")
  webPrice                  Decimal?         @db.Decimal(10, 2) @map("web_price")
  priceFrom                 Boolean          @default(true) @map("price_from")
  showPrice                 Boolean          @default(true) @map("show_price")
  discountEligible          Boolean          @default(true) @map("discount_eligible")
  requiresMedicalAssessment Boolean          @default(false) @map("requires_medical_assessment")
  requiresManualQuote       Boolean          @default(false) @map("requires_manual_quote")
  isSurgical                Boolean          @default(false) @map("is_surgical")
  active                    Boolean          @default(true)
  featured                  Boolean          @default(false)
  durationMinutes           Int?             @map("duration_minutes")
  image                     String?
  createdAt                 DateTime         @default(now()) @map("created_at")
  updatedAt                 DateTime         @updatedAt @map("updated_at")
  concerns                  ServiceConcern[]
  appointments              Appointment[]
  orders                    Order[]
  beforeAfter               BeforeAfter[]

  @@map("services")
}

model Concern {
  id       String           @id @default(cuid())
  name     String
  slug     String           @unique
  order    Int
  services ServiceConcern[]

  @@map("concerns")
}

model ServiceConcern {
  serviceId String  @map("service_id")
  concernId String  @map("concern_id")
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  concern  Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)

  @@id([serviceId, concernId])
  @@map("service_concerns")
}

model Location {
  id      String  @id @default(cuid())
  name    String
  city    String
  address String
  phone   String?
  mapsUrl String? @map("maps_url")
  active  Boolean @default(true)
  order   Int

  appointments Appointment[]
  orders      Order[] @relation("OrderLocation")

  @@map("locations")
}

model Professional {
  id             String  @id @default(cuid())
  name           String
  title          String
  bio            String
  photo          String?
  education      Json?
  experience     Json?
  certifications Json?
  publications   Json?
  procedures     Json?
  socials        Json?
  active         Boolean @default(true)

  appointments Appointment[]

  @@map("professionals")
}

model Patient {
  id            String        @id @default(cuid())
  firstName     String        @map("first_name")
  lastName      String        @map("last_name")
  documentId    String        @unique @map("document_id")
  email         String
  phone         String
  city          String?
  birthDate     DateTime?     @map("birth_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  appointments  Appointment[]
  orders        Order[]
  subscriptions Subscription[]
  account       PatientAccount?
  points        PointsTransaction[]

  @@map("patients")
}

model PatientAccount {
  id           String   @id @default(cuid())
  patientId    String   @unique @map("patient_id")
  email        String   @unique
  passwordHash String   @map("password_hash")
  referralCode String   @unique @map("referral_code")
  referredById String?  @map("referred_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  patient      Patient  @relation(fields: [patientId], references: [id])

  @@map("patient_accounts")
}

model PointsTransaction {
  id              String       @id @default(cuid())
  patientId       String       @map("patient_id")
  points          Int
  reason          PointsReason
  description     String
  orderId         String?      @map("order_id")
  appointmentId   String?      @map("appointment_id")
  expiresAt       DateTime?    @map("expires_at")
  expiredHandled  Boolean      @default(false) @map("expired_handled")
  createdAt       DateTime     @default(now()) @map("created_at")
  patient         Patient      @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@unique([orderId, reason, patientId])
  @@map("points_transactions")
}

model Reward {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String
  pointsCost  Int        @map("points_cost")
  minTier     RewardTier @default(ESSENTIAL) @map("min_tier")
  active      Boolean    @default(true)
  order       Int

  @@map("rewards")
}

model Lead {
  id               String     @id @default(cuid())
  name             String
  phone            String
  email            String?
  interestedService String?   @map("interested_service")
  source           LeadSource
  status           LeadStatus @default(NEW)
  notes            String?
  createdAt        DateTime   @default(now()) @map("created_at")

  @@map("leads")
}

model Appointment {
  id             String            @id @default(cuid())
  patientId      String            @map("patient_id")
  serviceId      String            @map("service_id")
  locationId     String            @map("location_id")
  professionalId String            @map("professional_id")
  date           DateTime
  status         AppointmentStatus @default(REQUESTED)
  notes          String?
  objective      String?
  intake         Json?
  promoCode      String?           @map("promo_code")
  createdAt      DateTime          @default(now()) @map("created_at")
  patient        Patient           @relation(fields: [patientId], references: [id])
  service        Service           @relation(fields: [serviceId], references: [id])
  location       Location          @relation(fields: [locationId], references: [id])
  professional   Professional      @relation(fields: [professionalId], references: [id])
  order          Order?

  @@map("appointments")
}

model Order {
  id              String        @id @default(cuid())
  patientId       String        @map("patient_id")
  serviceId       String        @map("service_id")
  locationId      String?       @map("location_id")
  preferredDate   DateTime?     @map("preferred_date")
  preferredSlot   String?       @map("preferred_slot")
  patientGoal     String?       @map("patient_goal")
  appointmentId   String?       @unique @map("appointment_id")
  basePrice       Decimal       @db.Decimal(10, 2) @map("base_price")
  discountPercent Decimal       @db.Decimal(5, 2) @map("discount_percent")
  discountAmount  Decimal       @db.Decimal(10, 2) @map("discount_amount")
  total           Decimal       @db.Decimal(10, 2)
  currency        String        @default("USD")
  paymentMethod   PaymentMethod @map("payment_method")
  status          OrderStatus   @default(PENDING)
  paidAt          DateTime?     @map("paid_at")
  pointsRedeemed Int           @default(0) @map("points_redeemed")
  pointsDiscount Decimal       @default(0) @db.Decimal(10, 2) @map("points_discount")
  referralCode   String?       @map("referral_code")
  channel        String        @default("WEB")
  acceptedTerms   Boolean       @map("accepted_terms")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  patient         Patient       @relation(fields: [patientId], references: [id])
  service         Service       @relation(fields: [serviceId], references: [id])
  location        Location?     @relation("OrderLocation", fields: [locationId], references: [id])
  appointment     Appointment?  @relation(fields: [appointmentId], references: [id])
  payments        Payment[]

  @@map("orders")
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @map("order_id")
  provider              String
  providerTransactionId String?       @map("provider_transaction_id")
  clientTransactionId   String        @unique @map("client_transaction_id")
  amount                Decimal       @db.Decimal(10, 2)
  status                PaymentStatus @default(PENDING)
  rawResponse           Json?         @map("raw_response")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  order                 Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique
  price         Decimal        @db.Decimal(10, 2)
  interval      String         @default("MONTH")
  description   String?
  tagline       String?
  focus         String?
  features      String[]       @default([])
  routeSlug     String?        @map("route_slug")
  image         String?
  active        Boolean        @default(true)
  order         Int
  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String                @id @default(cuid())
  patientId          String                @map("patient_id")
  planId             String                @map("plan_id")
  status             SubscriptionStatus    @default(PENDING)
  provider           String
  providerCustomerId String?               @map("provider_customer_id")
  providerToken      String?               @map("provider_token")
  cardHolderEnc      String?               @map("card_holder_enc")
  cardBrand          String?               @map("card_brand")
  cardLast4          String?               @map("card_last4")
  consentAt          DateTime?             @map("consent_at")
  consentIp           String?               @map("consent_ip")
  consentText         String?               @map("consent_text")
  termsVersion        String?               @map("terms_version")
  failedAttempts      Int                   @default(0) @map("failed_attempts")
  cancelReason        String?               @map("cancel_reason")
  startDate          DateTime              @default(now()) @map("start_date")
  nextBillingDate    DateTime?             @map("next_billing_date")
  lastBillingDate    DateTime?             @map("last_billing_date")
  cancelledAt        DateTime?             @map("cancelled_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")
  patient            Patient               @relation(fields: [patientId], references: [id])
  plan               SubscriptionPlan      @relation(fields: [planId], references: [id])
  payments           SubscriptionPayment[]

  @@map("subscriptions")
}

enum SubscriptionPaymentKind {
  INITIAL
  RECURRING
}

model SubscriptionPayment {
  id                    String                  @id @default(cuid())
  subscriptionId        String                  @map("subscription_id")
  kind                  SubscriptionPaymentKind
  provider              String
  clientTransactionId   String                  @unique @map("client_transaction_id")
  providerTransactionId String?                 @map("provider_transaction_id")
  amount                Decimal                 @db.Decimal(10, 2)
  status                PaymentStatus           @default(PENDING)
  periodStart           DateTime                @map("period_start")
  periodEnd             DateTime                @map("period_end")
  rawResponse           Json?                   @map("raw_response")
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  subscription          Subscription            @relation(fields: [subscriptionId], references: [id])

  @@map("subscription_payments")
}

model BeforeAfter {
  id            String   @id @default(cuid())
  title         String
  serviceId     String?  @map("service_id")
  beforeImage   String   @map("before_image")
  afterImage    String   @map("after_image")
  patientConsent Boolean @map("patient_consent")
  description   String?
  problem       String?
  goal          String?
  techniques    String?
  sessions      String?
  evolution     String?
  routeSlug     String?  @map("route_slug")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  service       Service? @relation(fields: [serviceId], references: [id])

  @@map("before_afters")
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  category    String
  coverImage  String?   @map("cover_image")
  published   Boolean   @default(false)
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("admin_users")
}
